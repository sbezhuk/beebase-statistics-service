# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=production

# debug | info | warn | error
LOG_LEVEL=warn

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Required: the shared session store. Every BeeBase service (not just
# auth-service) checks it on every request, so an access token can be
# rejected the instant its session is superseded by a newer one instead
# of staying valid until its own JWT expiry. For standalone `go run`
# against auth-service's docker-compose Redis also running on the host:
REDIS_ADDR=localhost:6379
REDIS_CONNECT_TIMEOUT=5s
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network Redis address — you don't need to change it for that path.

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one. For standalone
# `go run` against auth-service also running on the host:
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network auth-service address — you don't need to change it for that path.

# Required: apiary-service's, hive-service's, inspection-service's, and
# harvest-service's base URLs. This service holds no data of its own -
# every statistic it reports is computed fresh from these four on every
# request.
APIARY_SERVICE_URL=http://localhost:8082
HIVE_SERVICE_URL=http://localhost:8083
INSPECTION_SERVICE_URL=http://localhost:8084
HARVEST_SERVICE_URL=http://localhost:8087
# `docker compose up` (via beebase-gateway) overrides all four to
# in-network addresses — you don't need to change them for that path.
